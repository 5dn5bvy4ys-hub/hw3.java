import java.time.LocalDate;

public abstract class Employee implements Comparable<Employee>, Taxable, BonusCalculable {
    private String id;
    private String name;
    protected double baseSalary;
    private LocalDate joinDate;

    // المُشيد (Constructor)
    public Employee(String id, String name, double baseSalary, LocalDate joinDate) {
        this.id = id;
        this.name = name;
        this.baseSalary = baseSalary;
        this.joinDate = joinDate;
    }

    // الدوال المجردة والمعرفة
    public abstract double calculateNetSalary();

    @Override
    public int compareTo(Employee other) {
        return this.id.compareTo(other.id);
    }

    @Override
    public double calculateTax() {
        return this.baseSalary * TAX_RATE;
    }

    @Override
    public double calculateBonus(double performanceScore) {
        return this.baseSalary * (performanceScore / 100);
    }

    (Get// دوال الحصول على البيانات ters)
    public String getId() {
        return id;
    }

    public String getName() {
        return name;
    }

    public double getBaseSalary() {
        return baseSalary;
    }

    public LocalDate getJoinDate() {
        return joinDate;
    }

    @Override
    public String toString() {
        return "Employee{id='" + id + "', name='" + name + "', baseSalary=" + baseSalary + ", joinDate=" + joinDate + "}";
    }
}
